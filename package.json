{
  "name": "@kissblank/dsh-session-manager",
  "version": "1.0.2",
  "type": "module",
  "description": "Purge DSH Sessions for good, and manage them from one console: bulk delete, archive filters, search and sort.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Kiss_Blank",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KissBlank/dsh-session-manager.git"
  },
  "homepage": "https://github.com/KissBlank/dsh-session-manager#readme",
  "bugs": {
    "url": "https://github.com/KissBlank/dsh-session-manager/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "cleanup",
    "purge"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "assets",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "icon": "assets/icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node test/host-smoke.mjs && node test/client-smoke.cjs",
    "prepublishOnly": "node test/host-smoke.mjs && node test/client-smoke.cjs"
  }
}
